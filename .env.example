# Every setting the app reads. Copy this to .env and change what you need; each one
# has a working default except where noted. Nothing here is secret apart from the
# owner password, which you only need for the very first start.

# --- where it listens --------------------------------------------------------
PORT=3000
# 127.0.0.1 serves this machine only. Use 0.0.0.0 for a network or a container.
HOST=127.0.0.1
# The address people type, used in the links in invitation and reset emails. Without
# it the app guesses from the request, which is wrong behind a proxy.
# PUBLIC_URL=https://crm.example.org

# --- behind HTTPS ------------------------------------------------------------
# Set both of these when a reverse proxy terminates HTTPS in front of the app.
# TRUST_PROXY makes the X-Forwarded-* headers trusted (1 = one proxy in front), and
# it also makes the first-run setup code mandatory, because the request no longer
# looks local. COOKIE_SECURE=1 stops the session cookie travelling over plain HTTP.
# TRUST_PROXY=1
# COOKIE_SECURE=1
# Browser pages allowed to call the API, besides pages the app serves itself. The
# default covers the Vite dev server; an install that serves its own web app needs none.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- data and backups --------------------------------------------------------
# The database, the logo and the backups. In Docker this is the volume, /data.
# CRM_DATA_DIR=./apps/api/data
# CRM_BACKUP_DIR=<CRM_DATA_DIR>/backups
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# --- logging -----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- the first owner ---------------------------------------------------------
# Optional. Set all three and the owner account is created at startup, instead of
# the first person to open the app creating it. Remove them once it exists.
# OWNER_EMAIL=you@example.org
# OWNER_PASSWORD=
# OWNER_NAME=Owner

# --- rarely needed -----------------------------------------------------------
# Where the built web app lives. Only set this if it is not apps/web/dist.
# WEB_DIST_DIR=
